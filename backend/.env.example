# ── Supabase project credentials ─────────────────────────────────────────────
# Found in Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here          # server-side only, never expose to browser
SUPABASE_ANON_KEY=your-anon-public-key-here             # safe for browser clients

# ── Postgres connection string ────────────────────────────────────────────────
# Found in Supabase Dashboard → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── JWT verification ──────────────────────────────────────────────────────────
# Your Supabase project's JWT secret (Settings → API → JWT Secret).
# Used to verify tokens server-side without hitting the Supabase Auth API on every request.
JWT_SECRET=your-supabase-jwt-secret-here

# ── Upload config ─────────────────────────────────────────────────────────────
# Local directory for pending (unconfirmed) uploads. Created automatically if missing.
UPLOAD_TEMP_DIR=./tmp/pending
# How long (seconds) a pending upload is kept before expiry (default: 3600 = 1 hour)
UPLOAD_TTL_SECONDS=3600

# ── AI Insights Config ────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
INSIGHT_PROVIDER=groq
ASK_PROVIDER=claude

